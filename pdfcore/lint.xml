<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!--
        Bouncy Castle (pulled in by the PDF library for encrypted files) contains a TLS helper
        with an empty trust manager. The app has no network permission and never opens a
        connection, so the class is unreachable. The check stays on for the app's own code.
    -->
    <issue id="TrustAllX509TrustManager">
        <ignore regexp="bcpkix" />
    </issue>
</lint>
